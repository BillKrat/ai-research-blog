ANTHROPIC_API_KEY=

# Local Postgres (DEV). Matches ~/data/postgres-platform/docker-compose.yml's
# unauthenticated local setup - start it with `postgres-start`, stop with
# `postgres-stop`. Railway's own DATABASE_URL (PROD) is scoped separately in
# Railway's dashboard, never copied into this file - keep it that way, or a
# script that assumes "local" (e.g. scripts/reseed_triple_store.py) could
# end up pointed at production data.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blogresearch

# Which IProvider the app resolves at startup: claude | dci | postgres
# Defaults to "claude" if unset.
PROVIDER_NAME=claude

# Use CustomPresenter's formatting instead of HelloPresenter's.
# Defaults to "false" if unset.
USE_CUSTOM_PRESENTER=false

# Which TripleRepository backend the app resolves: postgres | oxigraph
# Independent of PROVIDER_NAME above. Defaults to "oxigraph" if unset.
TRIPLE_REPOSITORY_NAME=oxigraph

# Only read when TRIPLE_REPOSITORY_NAME=oxigraph. Directory for Oxigraph's
# on-disk RocksDB store - a real local database, separate from whatever
# ai-research-api-volume holds on Railway, with no server to install
# (unlike Postgres/Memgraph above). Leave unset and OxigraphTripleRepository
# uses an in-memory store instead: fine for tests, but data won't survive
# a process restart. View this store with `oxigraph-start` (opens a SPARQL
# UI at localhost:7878 - stop it with `oxigraph-stop` before anything else,
# e.g. the app itself, needs to open the same store: only one process can
# hold it open at a time).
# OXIGRAPH_STORE_PATH=./local_data/oxigraph

# Reseed whichever TripleRepository backend is active (TRIPLE_REPOSITORY_NAME
# above) from shared/seed_data/initial_triples.json - deletes everything in
# the store first, then recreates the seed set. Prompts for confirmation
# unless the target looks local; add --yes to skip that for scripted use.
#   python scripts/reseed_triple_store.py

# Railway / deployment-specific values.
# FRONTEND_ORIGIN=https://your-frontend.up.railway.app
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app

# Neo4j Aura connection (graph DB, OpenCypher). Get these from the Aura
# console's Developer Hub -> Python for your instance. Leave unset locally
# and the live Neo4j tests skip themselves - see tests/test_neo4j_connection.py.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Local Memgraph connection (graph DB, openCypher, same Bolt protocol as
# Neo4j - the `neo4j` driver above talks to both). Only needed to override
# the defaults, which already match
# ~/data/memgraph-platform/docker-compose.yml's unauthenticated local setup -
# see tests/test_memgraph_connection.py.
# MEMGRAPH_URI=bolt://localhost:7687
# MEMGRAPH_USERNAME=
# MEMGRAPH_PASSWORD=
