<Project Sdk="Microsoft.NET.Sdk">

  <!-- Boots the real AiBlogResearch.WebApi host. Kept apart from AiBlogResearch.WebApi.Tests on purpose: that project holds test doubles
       (FakeUserPresenter, ...) which the reflection-based lifetime scan would also register, so a host booted inside it is not the real one. -->
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<IsPackable>false</IsPackable>
	<IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
	<PackageReference Include="xunit" Version="2.9.2" />
	<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\src\AiBlogResearch.WebApi\AiBlogResearch.WebApi.csproj" />
	<!-- Built, not referenced: the plug-in tests load it as a DLL from a plug-in directory, the way a developer's plug-in is loaded. -->
	<ProjectReference Include="..\..\..\Adventures.Foundation\test\Adventures.MEF.SampleWebPlugin\Adventures.MEF.SampleWebPlugin.csproj" ReferenceOutputAssembly="false" OutputItemType="SampleWebPluginDll" />
  </ItemGroup>

  <Target Name="CopySampleWebPlugin" AfterTargets="Build">
	<Copy SourceFiles="@(SampleWebPluginDll)" DestinationFolder="$(OutDir)sample-web-plugin" />
	<Copy SourceFiles="@(SampleWebPluginDll->'%(RootDir)%(Directory)Adventures.MEF.SampleWebPlugin.deps.json')" DestinationFolder="$(OutDir)sample-web-plugin" Condition="Exists('%(RootDir)%(Directory)Adventures.MEF.SampleWebPlugin.deps.json')" />
  </Target>

  <ItemGroup>
    <!-- The schema browser end to end: the applications client and the gateway against this API. -->
    <ProjectReference Include="..\..\..\Adventures.Foundation\src\Adventures.Browser.Client\Adventures.Browser.Client.csproj" />
    <ProjectReference Include="..\..\..\Adventures.Foundation\src\Adventures.Browser.Gateway.WebApi\Adventures.Browser.Gateway.WebApi.csproj" />
  </ItemGroup>

</Project>
