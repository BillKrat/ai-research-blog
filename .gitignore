# .NET
bin/
obj/
*.user
*.suo

# Angular / Node
client/**/node_modules/
client/**/dist/
client/**/.angular/
npm-debug.log*

# Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/extensions.json

# Environments / secrets
.env
.envrc

# Local Oxigraph on-disk store (OXIGRAPH_STORE_PATH default in .env.example)
/local_data/

# Local Postgres container's data files (local/postgres/docker-compose.yml)
# - the schema/fixture config itself (init/001-schema.sql) is real,
# versioned config and stays tracked; only the runtime data is ignored.
/local/postgres/data/

# Artifacts / Docs — large reference downloads only, not the folder itself
artifacts/*.epub

# macOS
.DS_Store
