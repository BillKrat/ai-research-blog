<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local folder feed for Adventures.* packages before they're published to nuget.org for real.
         Not committed as package content - just a package source pointer. Sibling folder to this
         repo (M:\Dev\repos\ai-research-blog) and Adventures.Foundation, which packs into it. See
         Adventures.Foundation/README.md for the publish-to-nuget.org path once versions stabilize. -->
    <add key="adventures-local" value="../local-nuget-feed" />
  </packageSources>
</configuration>
