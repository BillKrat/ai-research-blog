<?xml version="1.0" encoding="utf-8"?>
<!--
  Checked in (unlike a typical ASP.NET Core project, which lets dotnet publish generate this from
  scratch) purely to set stdoutLogEnabled="true" - a second, independent diagnostic trail for a
  startup-time crash that happens before even Serilog's own bootstrap logger can run. The dotnet
  publish web.config transform merges into this file rather than overwriting it, so this setting
  survives every future publish.

  Deliberately contains NO <environmentVariables> and no secrets - those live in the
  billkrat-001611 IIS Application Pool's own Environment Variables (SmarterASP Advanced Tools ->
  Pool Manager -> [pool] -> Environment Variables), which persists independently of any deploy and
  never touches source control. See docs/SESSION_HANDOFF.md's 2026-09-19 production incident
  writeup for why that distinction matters here.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\AiBlogResearch.WebApi.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
