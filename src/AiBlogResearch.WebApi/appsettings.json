{
  "Jwt": {
    "Issuer": "AiBlogResearch.WebApi",
    "Audience": "AiBlogResearch.Clients",
    "AccessTokenLifetime": "00:30:00"
  },
  "M2MClients": {
    "Clients": [
      {
        "ClientId": "mcp-host",
        "Scopes": ["mcp.postgres.query", "mcp.filesearch.search", "mcp.hello"]
      },
      {
        "ClientId": "mcp-server-postgres",
        "Scopes": ["mcp.postgres.query"]
      },
      {
        "ClientId": "mcp-server-filesearch",
        "Scopes": ["mcp.filesearch.search"]
      },
      {
        "_comment": "Claude's read-only diagnostics client. Index 3: secrets are bound by index (M2MClients:Clients:3:Secret), so append new clients, never insert. No secret set = the client is inactive.",
        "ClientId": "claude-diagnostics",
        "Scopes": ["mcp.diagnostics.read"]
      },
      {
        "_comment": "Claude's drafts-only authoring client (create and revise its own draft posts, list and create categories and tags; no publish). Index 4, appended: no secret set = the client is inactive.",
        "ClientId": "claude-author",
        "Scopes": ["content.draft"]
      },
      {
        "_comment": "Claude's read-only research client for the legacy BlogEngine.NET (BlogAI) database, through the MCP blogai_* tools. Index 5, appended: no secret set = the client is inactive.",
        "ClientId": "claude-research",
        "Scopes": ["blogai.read"]
      }
    ]
  },
  "Anthropic": {
    "KeyExpiresOn": "2026-11-18"
  },
  "McpServer": {
    "BaseUrl": "https://mcp.global-webnet.com/"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://global-webnet.com",
      "https://global-webnet.com",
      "http://www.global-webnet.com",
      "https://www.global-webnet.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
