<?xml version="1.0" encoding="utf-8"?>
<!--
  Checked in (mirrors src/AiBlogResearch.WebApi/web.config) purely to set stdoutLogEnabled="true" -
  this service has no Serilog file sink of its own, so this is its only startup-crash diagnostic
  trail. dotnet publish's web.config transform merges into this file rather than overwriting it.

  Deliberately contains NO <environmentVariables> and no secrets - those live in this site's own
  IIS Application Pool Environment Variables (SmarterASP Advanced Tools -> Pool Manager), same
  convention as api.global-webnet.com.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\McpServer.WebApi.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
