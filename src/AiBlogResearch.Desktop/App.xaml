<Application x:Class="AiBlogResearch.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Adventures.Client;assembly=Adventures.Client"
             xmlns:views="clr-namespace:AiBlogResearch.Desktop.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- A screen view model is shown by its view: MainWindow only displays ShellViewModel.Current. -->
        <DataTemplate DataType="{x:Type vm:SignInViewModel}"><views:SignInView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EntityListViewModel}"><views:EntityListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EntityEditViewModel}"><views:EntityEditView /></DataTemplate>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B00020" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Application.Resources>
</Application>
