<Window x:Class="AiBlogResearch.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adventures - People" Width="900" Height="600" MinWidth="520" MinHeight="400">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <Button Content="Sign out" Command="{Binding SignOutCommand}" Padding="10,2" />
        </StatusBar>
        <ContentControl Content="{Binding Current}" Margin="16" />
    </DockPanel>
</Window>
