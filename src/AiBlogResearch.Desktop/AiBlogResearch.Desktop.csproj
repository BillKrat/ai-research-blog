<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF desktop client (S9). Windows only; CI builds the web projects one by one, so this never enters a Linux build. -->
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows</TargetFramework>
	<UseWPF>true</UseWPF>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>AiBlogResearch.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
	<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\..\Adventures.Foundation\src\Adventures.Client\Adventures.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
