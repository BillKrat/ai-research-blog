<UserControl x:Class="AiBlogResearch.Desktop.Views.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="320" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Sign in" FontSize="22" Margin="0,0,0,12" />
        <TextBlock Text="User name" />
        <TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
        <TextBlock Text="Password" />
        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" Margin="0,2,0,12" />
        <Button Content="Sign in" Command="{Binding SignInCommand}" IsDefault="True" Padding="12,4" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
    </StackPanel>
</UserControl>
