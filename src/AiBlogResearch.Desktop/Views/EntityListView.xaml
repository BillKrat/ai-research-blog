<UserControl x:Class="AiBlogResearch.Desktop.Views.EntityListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="New" Command="{Binding NewCommand}" Padding="12,3" Margin="0,0,8,0" />
            <Button Content="Edit" Command="{Binding EditCommand}" Padding="12,3" Margin="0,0,8,0" />
            <Button Content="Refresh" Command="{Binding LoadCommand}" Padding="12,3" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Previous" Command="{Binding PreviousCommand}" Padding="10,2" />
            <TextBlock VerticalAlignment="Center" Margin="10,0">
                <Run Text="Page" /> <Run Text="{Binding Page, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding TotalPages, Mode=OneWay}" />
            </TextBlock>
            <Button Content="Next" Command="{Binding NextCommand}" Padding="10,2" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{StaticResource ErrorText}" />
        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" MouseDoubleClick="OnDoubleClick" />
    </DockPanel>
</UserControl>
