<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The NQuad browser: browse and edit the schemas and entities of an N-Quad store. It is built only from the reusable libraries
    (Entities, Data.NQuad, Security, WebApi). It references no blog, collaboration or identity-store project; the architecture guard in
    AiBlogResearch.WebApi.Tests fails the build if that ever changes.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The same user-secrets store as the main API, so the browser reads the same Jwt settings and (when set) the same Postgres connection in development. -->
    <UserSecretsId>aiblogresearch-webapi-c9b1f4b2-8f3a-4a3a-9d1e-6a6b4d0b3f21</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Adventures.Foundation\src\Adventures.Entities\Adventures.Entities.csproj" />
    <ProjectReference Include="..\..\..\Adventures.Foundation\src\Adventures.Data.NQuad\Adventures.Data.NQuad.csproj" />
    <ProjectReference Include="..\..\..\Adventures.Foundation\src\Adventures.Security\Adventures.Security.csproj" />
    <ProjectReference Include="..\..\..\Adventures.Foundation\src\Adventures.Security.AspNetCore\Adventures.Security.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\Adventures.Foundation\src\Adventures.WebApi\Adventures.WebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seeds that describe the schemas the browser lists (used when it runs on its own in-memory store). -->
    <None Include="..\..\..\Adventures.Foundation\src\Adventures.Data.NQuad\Sql\seed\seed.nq" Link="Sql\seed\seed.nq" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\Adventures.Foundation\src\Adventures.Data.NQuad\Sql\seed\seed-002-exception-log.nq" Link="Sql\seed\seed-002-exception-log.nq" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\Adventures.Foundation\src\Adventures.Data.NQuad\Sql\seed\seed-003-exception-signature.nq" Link="Sql\seed\seed-003-exception-signature.nq" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\Adventures.Foundation\src\Adventures.Data.NQuad\Sql\seed\seed-004-identity.nq" Link="Sql\seed\seed-004-identity.nq" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\Adventures.Foundation\src\Adventures.Data.NQuad\Sql\seed\seed-005-identity-required.nq" Link="Sql\seed\seed-005-identity-required.nq" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
