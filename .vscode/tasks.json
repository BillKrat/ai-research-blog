{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "API: uvicorn",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "uvicorn",
                "app:app",
                "--port",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "uvicorn",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^INFO:.*Started server process",
                    "endsPattern": "^INFO:.*Application startup complete"
                }
            }
        }
    ]
}
