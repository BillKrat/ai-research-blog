<?xml version="1.0" encoding="utf-8"?>
<!--
  The static web site's own IIS settings, shipped with the client so that every deploy carries them. The rules are tested in
  src/app/web-config.spec.ts. Needs the IIS URL Rewrite module (SmarterASP.NET has it). No application settings or secrets belong
  here. The single-site deploy removes this file, because there the API serves the client and has its own web.config.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          Plain http goes to https. Left alone: the certificate challenge folder, a request a proxy already received over https,
          and local or temporary addresses, which may have no certificate. A real domain needs its certificate first.
        -->
        <rule name="Redirect to https" stopProcessing="true">
          <match url="^\.well-known/" negate="true" />
          <conditions>
            <add input="{HTTPS}" pattern="^off$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
            <add input="{HTTP_HOST}" pattern="^(localhost|127\.0\.0\.1)(:\d+)?$|\.[adf]tempurl\.com(:\d+)?$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <!-- An address that is not a file belongs to the Angular router. A missing script, style or font stays a 404. -->
        <rule name="Application deep links" stopProcessing="true">
          <match url="^\.well-known/" negate="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_URI}" pattern="^[^?]*\.(js|css|map|woff2?)(\?.*)?$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <!-- Browsers revalidate each file (a 304 when unchanged), so a new deploy shows up on the next page load. -->
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
